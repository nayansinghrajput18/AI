
low = 1
high = 100

print("Think of a number between 1 and 100")

while low <= high:
    guess = (low + high) // 2

    print("My guess is:", guess)
    feedback = input("Enter H for Higher, L for Lower, C for Correct: ").upper()

    if feedback == "H":
        low = guess + 1

    elif feedback == "L":
        high = guess - 1

    elif feedback == "C":
        print("Number guessed successfully!")
        break

    else:
        print("Invalid input")
        continue

else:
    print("All possible guesses are exhausted!")
    print("Number not found. Feedback may be incorrect.")
